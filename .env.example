# Microstash Environment Configuration Example
# Copy this file to .env and insert your API keys

# NVIDIA NIM API Key (for LLaMA 3.1 Nemotron 70B & fast synthesis)
# Obtain from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google Gemini API Key (for Gemini 3.5 Flash / Flash Lite)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Default AI Provider (gemini or nvidia)
DEFAULT_AI_PROVIDER=gemini

# Model Identifiers
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
GEMINI_MODEL=gemini-3.5-flash-lite
